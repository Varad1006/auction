# Copy to .env.local for local development, and set the same variables in
# Vercel (Project Settings -> Environment Variables) for production.

# Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xltgjnmeccyzncstgtlv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # "anon" / "publishable" key (safe for browsers)
SUPABASE_SERVICE_ROLE_KEY=               # "service_role" / "secret" key (server only, never expose)

# Comma-separated Gmail addresses with full admin access
ADMIN_EMAILS=you@gmail.com

# Optional
NEXT_PUBLIC_APP_NAME=Cricket Auction
NEXT_PUBLIC_CURRENCY_LABEL=pts
