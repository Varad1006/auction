# Copy to .env.local for local development, and set the same variables in
# Vercel (Project Settings -> Environment Variables) for production.

# Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xltgjnmeccyzncstgtlv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # "anon" / "publishable" key (safe for browsers)
SUPABASE_SERVICE_ROLE_KEY=               # "service_role" / "secret" key (server only, never expose)

# Comma-separated Gmail addresses with full admin access
ADMIN_EMAILS=you@gmail.com

# Optional
NEXT_PUBLIC_APP_NAME=Cricket Auction
NEXT_PUBLIC_CURRENCY_LABEL=pts
# Google Search Console HTML-tag verification code (content="..." value only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Contact for wishlist push notifications (https:// URL or mailto:). Defaults
# to the site's own URL; the push keys themselves are generated automatically.
# VAPID_SUBJECT=mailto:you@gmail.com

# AI scouting notes (Admin -> AI insights). Server-only. The price guide
# works without either key; a key adds the AI's notes.
# Free: console.groq.com -> API Keys (uses a Qwen model).
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3-32b    # only to pick a different Groq model
# Or Claude: console.anthropic.com -> API keys.
# ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic        # with both keys set; Groq is the default

# Only for scripts/apply-migrations.mjs (Dashboard -> Account -> Access Tokens)
# SUPABASE_ACCESS_TOKEN=
