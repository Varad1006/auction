{
  "name": "cricket-auction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "bash scripts/db-local.sh",
    "icons": "node scripts/make-icons.mjs",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@localhost:5432/postgres} vitest run tests/db",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/register.mjs && node tests/e2e/signings.mjs && node tests/e2e/insights.mjs && node tests/e2e/mobile.mjs && node tests/e2e/backup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "fflate": "0.7.5",
    "jsqr": "^1.4.0",
    "next": "^16.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
